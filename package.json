{
  "name": "minas-explorer",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "catalog": "node scripts/build-catalog.mjs",
    "geo": "node scripts/prepare-geo-data.mjs",
    "start": "npm run catalog && ng serve",
    "build": "npm run catalog && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run catalog && ng test",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "build:pages": "npm run catalog && ng build --base-href /minas-explorer/",
    "preview:pages": "node scripts/preview-pages.mjs"
  },
  "private": true,
  "packageManager": "npm@12.2.2",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide": "^1.77.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.20.5",
    "angular-eslint": "^22.8.0",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.33",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.0"
  }
}
